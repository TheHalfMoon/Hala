            {
              "n": 1,
              "sign": "+",
              "text": "\"\"\"DEV-only descriptive error accounting; no production imports or edits.\"\"\""
            },
            {
              "n": 2,
              "sign": "+",
              "text": "import json"
            },
            {
              "n": 3,
              "sign": "+",
              "text": "from collections import Counter"
            },
            {
              "n": 4,
              "sign": "+",
              "text": "from pathlib import Path"
            },
            {
              "n": 5,
              "sign": "+",
              "text": "root=Path(__file__).resolve().parents[1]"
            },
            {
              "n": 6,
              "sign": "+",
              "text": "def read(p): return json.loads((root/p).read_text(encoding='utf-8'))"
            },
            {
              "n": 7,
              "sign": "+",
              "text": "d=read('outputs/h21-kaggle-retry1-adapter-dev-evidence/adapter-dev/result.json')"
            },
            {
              "n": 8,
              "sign": "+",
              "text": "replay=read('work/h21-retained-candidate-dev-actual-review.json')"
            },
            {
              "n": 9,
              "sign": "+",
              "text": "dataset=read('outputs/h21-frozen-data/dataset.json')"
            },
            {
              "n": 10,
              "sign": "+",
              "text": "frozen={e['id']:e for e in dataset['episodes'] if e['split']=='dev'}"
            },
            {
              "n": 11,
              "sign": "+",
              "text": "boxes={e['episode']:e['boxes'] for e in replay['episodes']}"
            },
            {
              "n": 12,
              "sign": "+",
              "text": "counts=Counter(); rows=[]; semantic=Counter(); model=Counter(); text=Counter()"
            },
            {
              "n": 13,
              "sign": "+",
              "text": "for ep in d['episodes']:"
            },
            {
              "n": 14,
              "sign": "+",
              "text": "    e=frozen[ep['episode']]; b=boxes[e['id']]; language=e['language']"
            },
            {
              "n": 15,
              "sign": "+",
              "text": "    def hit(p,key):"
            },
            {
              "n": 16,
              "sign": "+",
              "text": "        x,y=min(p[0]*800//1000,799),min(p[1]*600//1000,599); l,t,w,h=b[key]"
            },
            {
              "n": 17,
              "sign": "+",
              "text": "        return l<=x<l+w and t<=y<t+h"
            },
            {
              "n": 18,
              "sign": "+",
              "text": "    per=Counter()"
            },
            {
              "n": 19,
              "sign": "+",
              "text": "    for t in ep['trace']:"
            },
            {
              "n": 20,
              "sign": "+",
              "text": "        p=t['proposal']; action=p['action']; before=t['before']"
            },
            {
              "n": 21,
              "sign": "+",
              "text": "        counts[(language,'actions',action)]+=1"
            },
            {
              "n": 22,
              "sign": "+",
              "text": "        if action=='type': text['correct' if p['text']==e['requested_value'] else 'incorrect']+=1"
            },
            {
              "n": 23,
              "sign": "+",
              "text": "        if not t['action_error']: continue"
            },
            {
              "n": 24,
              "sign": "+",
              "text": "        counts[(language,'errors',action)]+=1"
            }
          ],
          "dropped": 15
        }
      ]
