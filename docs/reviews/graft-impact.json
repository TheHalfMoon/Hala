            },
            {
              "n": 7,
              "sign": "+",
              "text": "class CostTests(unittest.TestCase):"
            },
            {
              "n": 8,
              "sign": "+",
              "text": "    def test_work_and_idle_are_accounted_separately(self):"
            },
            {
              "n": 9,
              "sign": "+",
              "text": "        inputs = CostInputs(users=10, tasks_per_user=100, model_calls_per_task=2,"
            },
            {
