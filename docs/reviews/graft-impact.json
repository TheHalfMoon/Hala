              "sign": "+",
              "text": "                            gpu_seconds_per_call=3, retry_rate=0.1,"
            },
            {
              "n": 11,
              "sign": "+",
              "text": "                            success_rate=0.8, gpu_hourly_usd=1,"
            },
            {
              "n": 12,
              "sign": "+",
              "text": "                            warm_workers=1, month_hours=720,"
            },
            {
              "n": 13,
              "sign": "+",
              "text": "                            storage_gb=10, storage_usd_per_gb=0.1,"
            },
            {
              "n": 14,
              "sign": "+",
              "text": "                            network_gb_per_task=0.001, network_usd_per_gb=0.2,"
            },
            {
              "n": 15,
              "sign": "+",
              "text": "                            failure_cost_usd=0.01)"
            },
            {
              "n": 16,
              "sign": "+",
              "text": "        result = estimate(inputs)"
