            {
              "n": 2,
              "sign": "+",
              "text": "import argparse"
            },
            {
              "n": 3,
              "sign": "+",
              "text": "import json"
            },
            {
              "n": 4,
              "sign": "+",
              "text": "from pathlib import Path"
            },
            {
              "n": 5,
              "sign": "+",
              "text": ""
            },
            {
              "n": 6,
              "sign": "+",
              "text": "from training.adaptation import audit, read"
            },
            {
              "n": 7,
              "sign": "+",
              "text": "from training.artifacts import sha256_file"
            },
            {
              "n": 8,
              "sign": "+",
              "text": ""
            },
            {
              "n": 9,
              "sign": "+",
              "text": ""
            },
            {
              "n": 10,
              "sign": "+",
              "text": "def main():"
            },
            {
              "n": 11,
              "sign": "+",
              "text": "    parser = argparse.ArgumentParser(description=__doc__)"
            },
            {
              "n": 12,
              "sign": "+",
              "text": "    parser.add_argument('--root', type=Path, default=Path(__file__).resolve().parents[1])"
            },
            {
              "n": 13,
              "sign": "+",
              "text": "    parser.add_argument('--output', type=Path)"
            },
            {
              "n": 14,
              "sign": "+",
              "text": "    args = parser.parse_args()"
            },
            {
              "n": 15,
              "sign": "+",
              "text": "    config = read(args.root / 'experiments/adaptation/shared-multitask.json')"
            },
            {
              "n": 16,
              "sign": "+",
              "text": "    result = audit(args.root, config)"
            },
            {
              "n": 17,
              "sign": "+",
              "text": "    result['evidence_sha256']['experiments/adaptation/shared-multitask.json'] = sha256_file("
            },
            {
              "n": 18,
              "sign": "+",
              "text": "        args.root / 'experiments/adaptation/shared-multitask.json')"
            },
            {
              "n": 19,
              "sign": "+",
              "text": "    payload = json.dumps(result, indent=2, sort_keys=True, allow_nan=False) + '\\n'"
            },
            {
              "n": 20,
              "sign": "+",
              "text": "    if args.output:"
            },
            {
              "n": 21,
              "sign": "+",
              "text": "        args.output.write_text(payload, encoding='utf-8')"
            },
            {
              "n": 22,
              "sign": "+",
              "text": "    else:"
            },
            {
              "n": 23,
              "sign": "+",
              "text": "        print(payload, end='')"
            },
            {
              "n": 24,
              "sign": "+",
              "text": "    return 0 if result['training_ready'] else 2"
            }
          ],
          "dropped": 4
        }
      ]
